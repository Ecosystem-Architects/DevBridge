# Supabase project credentials (frontend, anon/public key — safe for browsers)
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key — BACKEND / Edge Functions ONLY. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional stretch: Python AI service (not used by MVP)
AI_SERVICE_URL=http://localhost:8000
